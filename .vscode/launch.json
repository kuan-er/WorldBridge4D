{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "加载 100k CKPT 的 FSDP 单步（GPU 0,1）",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "CUDA_VISIBLE_DEVICES": "0,1",
                "PYTHONUNBUFFERED": "1",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
            },
            "args": [
                "--standalone",
                "--nproc-per-node=2",
                "${workspaceFolder}/scripts/train.py",
                "--config",
                "${workspaceFolder}/configs/worldbridge4d_256_source_rgb_fusion32_step100000.yaml",
                "--output-dir",
                "/data/WorldBridge4D-runs/debug-fsdp-one-step",
                "--checkpoint-dir",
                "/data/WorldBridge4D-runs/debug-fsdp-one-step",
                "--resume",
                "/data/WorldBridge4D-persistent/checkpoints/worldbridge4d-source-rgb-fusion32-cap0p1-step100000/checkpoint-0100000.pt",
                "--steps",
                "100001",
                "--allow-two-gpu-gate",
                "--lazy-vae-cache",
                "--disable-wandb",
                "--no-checkpoint"
            ]
        }
    ]
}
