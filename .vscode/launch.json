{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dense4D canonical smoke",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/bin/python",
      "program": "${workspaceFolder}/train_dense4d.py",
      "args": [
        "--config",
        "${workspaceFolder}/configs/dense4d_smoke.yaml",
        "--output-dir",
        "/tmp/worldbridge_dense4d_debug/smoke",
        "--device",
        "cuda"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WANDB_MODE": "disabled",
        "CUDA_LAUNCH_BLOCKING": "1"
      }
    },
    {
      "name": "Dense4D canonical bounded train",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/bin/python",
      "program": "${workspaceFolder}/train_dense4d.py",
      "args": [
        "--config",
        "${workspaceFolder}/configs/dense4d_train.yaml",
        "--output-dir",
        "/tmp/worldbridge_dense4d_debug/train",
        "--device",
        "cuda"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WANDB_MODE": "disabled",
        "CUDA_LAUNCH_BLOCKING": "1"
      }
    },
    {
      "name": "Dense4D unit tests",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/bin/python",
      "module": "pytest",
      "args": ["-q", "tests/test_dense4d.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WANDB_MODE": "disabled",
        "CUDA_VISIBLE_DEVICES": ""
      }
    },
    {
      "name": "Compact baseline",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/bin/python",
      "program": "${workspaceFolder}/scripts/train.py",
      "args": ["--config", "${workspaceFolder}/configs/compact.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WANDB_MODE": "disabled"
      }
    }
  ]
}
