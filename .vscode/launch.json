{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dense4D train - full chain (tiny)",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/bin/python",
      "program": "${workspaceFolder}/train_dense4d.py",
      "args": [
        "--config",
        "${workspaceFolder}/configs/dense4d_tiny_overfit.yaml",
        "--output-dir",
        "/tmp/worldbridge_debug/dense4d_tiny",
        "--device",
        "cuda"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WANDB_MODE": "disabled",
        "CUDA_LAUNCH_BLOCKING": "1"
      }
    },
    {
      "name": "Dense4D train - canonical bounded",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/bin/python",
      "program": "${workspaceFolder}/train_dense4d.py",
      "args": [
        "--config",
        "${workspaceFolder}/configs/dense4d_train.yaml",
        "--output-dir",
        "/tmp/worldbridge_debug/dense4d_train",
        "--device",
        "cuda"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WANDB_MODE": "disabled",
        "CUDA_LAUNCH_BLOCKING": "1"
      }
    },
    {
      "name": "Dense4D evaluate - checkpoint to metrics",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/bin/python",
      "program": "${workspaceFolder}/evaluate_dense4d.py",
      "args": [
        "--checkpoint",
        "${input:dense4dCheckpoint}",
        "--output",
        "/tmp/worldbridge_debug/dense4d_evaluation.json",
        "--split",
        "validation",
        "--max-clips",
        "1",
        "--pair-chunk",
        "8",
        "--pixel-stride",
        "16",
        "--device",
        "cuda"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WANDB_MODE": "disabled",
        "CUDA_LAUNCH_BLOCKING": "1"
      }
    },
    {
      "name": "Dense4D inspect dataset adapter",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/bin/python",
      "program": "${workspaceFolder}/scripts/inspect_dataset.py",
      "args": [
        "--data-root",
        "/dataset/MOVi-F",
        "--split",
        "train",
        "--max-records",
        "1"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "WANDB_MODE": "disabled"
      }
    }
  ],
  "inputs": [
    {
      "id": "dense4dCheckpoint",
      "type": "promptString",
      "description": "Checkpoint path, for example /tmp/worldbridge_debug/dense4d_train/checkpoint.pt",
      "default": "/tmp/worldbridge_debug/dense4d_train/checkpoint.pt"
    }
  ]
}
