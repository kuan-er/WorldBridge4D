{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldbridge4d.local/schemas/dataset-manifest-v1.json",
  "title": "WorldBridge4D Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "dataset", "clip", "camera", "geometry", "wan_latent",
    "splits", "artifacts", "producer"
  ],
  "properties": {
    "protocol": {"const": "worldbridge4d.dataset.v1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source_uri", "source_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "license": {"type": ["string", "null"]}
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "height", "width", "channels", "rgb_dtype", "temporal_policy"],
      "properties": {
        "frames": {"const": 21},
        "height": {"const": 128},
        "width": {"const": 128},
        "channels": {"const": 3},
        "rgb_dtype": {"enum": ["uint8", "float32_0_1"]},
        "temporal_policy": {"const": "ordered_no_padding_no_interpolation"},
        "fps": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "default_stride": {"type": "integer", "minimum": 1}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intrinsics", "pose", "optical_axis", "image_axes", "pixel_center",
        "world_units", "depth_convention"
      ],
      "properties": {
        "intrinsics": {"const": "per_frame_3x3"},
        "pose": {"const": "camera_to_world_4x4"},
        "optical_axis": {"const": "-z"},
        "image_axes": {"const": "u_right_v_down"},
        "pixel_center": {"const": "integer_uv"},
        "world_units": {"const": "meters"},
        "depth_convention": {"enum": ["radial_meters", "z_meters"]}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_mode", "coordinate_frame", "validity_semantics"],
      "properties": {
        "annotation_mode": {"enum": ["rigid_instances", "dense_xyz"]},
        "coordinate_frame": {"const": "source_camera"},
        "validity_semantics": {"const": "valid_not_visibility_occluded_valid_supervised"},
        "dense_xyz_storage_dtype": {"enum": ["float32", "float16"]},
        "visibility_available": {"type": "boolean"}
      }
    },
    "wan_latent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model", "checkpoint_sha256", "posterior", "normalization", "dtype", "shape"
      ],
      "properties": {
        "model": {"const": "Wan2.1-T2V-1.3B-VAE"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "posterior": {"const": "mean"},
        "normalization": {"const": "native_wan_channel_mean_std"},
        "dtype": {"const": "float32"},
        "shape": {
          "type": "array",
          "prefixItems": [
            {"const": 16}, {"const": 6}, {"const": 16}, {"const": 16}
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "splits": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/split"},
      "required": ["train", "validation"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "argv", "seed", "created_at_utc"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "seed": {"type": "integer"},
        "created_at_utc": {"type": "string", "format": "date-time"},
        "python": {"type": "string"},
        "torch": {"type": "string"},
        "cuda": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clips", "parents", "index_path", "index_sha256"],
      "properties": {
        "clips": {"type": "integer", "minimum": 1},
        "parents": {"type": "integer", "minimum": 1},
        "index_path": {"type": "string", "minLength": 1},
        "index_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "split", "path", "format", "bytes", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "split_index", "sample_shard", "wan_latent_shard",
            "coordinate_stats", "compact_source_geometry_shard",
            "dense_xyz_shard", "validation_report", "training_config"
          ]
        },
        "split": {"type": ["string", "null"]},
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["json", "jsonl", "npz", "safetensors", "pt_tensors", "npy_mmap"]},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "first_clip_index": {"type": "integer", "minimum": 0},
        "clip_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
