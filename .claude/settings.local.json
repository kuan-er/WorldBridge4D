      "Bash(curl -s --max-time 10 -x http://localhost:7890 https://api.anthropic.com/v1/messages -X POST -H \"Content-Type: application/json\" -d '{}')",
      "Bash(curl -s --max-time 10 -x http://localhost:7890 https://www.google.com -o /dev/null -w \"HTTP_CODE: %{http_code}\\\\n\")",
